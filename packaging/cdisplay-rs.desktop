[Desktop Entry]
Type=Application
Name=CDisplay
GenericName=Comic Book Reader
Comment=Read comic archives and image folders (CDisplay port)
Exec=cdisplay-rs %f
Terminal=false
Categories=Graphics;Viewer;
MimeType=application/vnd.comicbook+zip;application/vnd.comicbook-rar;application/x-cbz;application/x-cbr;application/x-cb7;application/x-cbt;application/zip;application/x-rar;application/x-7z-compressed;image/webp;image/jxl;
